generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String    @id @default(uuid(7))
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

enum MessageRole {
  system
  user
  assistant
}

/// One AI SDK UIMessage. `parts` holds UIMessage.parts; validate with safeValidateUIMessages when loading.
model Message {
  id        String      @id
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  parts     Json
  model     String?
  position  Int
  createdAt DateTime    @default(now())

  @@unique([sessionId, position])
}
